# Copy to .dev.vars. Values are server-only. Never commit .dev.vars.
# Model availability and price checked against Google's docs, 31 October 2026.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_REASONING=gemini-3.5-flash-lite
AI_ENABLED=true
# Long random secret for protected local ingestion and batch jobs.
ADMIN_TOKEN=
# Bounded interactive PDF safeguards. Larger original files use import-local-pdf.mjs.
PDF_MAX_MB=8
PDF_MAX_PAGES=500

# Optional encrypted Site service credential for the bounded scheduled writer. Never set a browser variable.
SITES_SCHEDULED_TOKEN=
